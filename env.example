# Copy to .env for local runs. These are dummy values for a local AWS emulator.
# Never put a real AWS key here. Never commit .env.

# Local AWS emulator (Moto server by default; see docs/decisions.md D2).
AWS_ENDPOINT_URL=http://127.0.0.1:5050
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-southeast-2

# Resources created by infra/terraform (or by the boto3 init fallback).
RAW_BUCKET=mcb-raw-readings
CURATED_BUCKET=mcb-curated-exports
INGEST_QUEUE_NAME=mcb-ingest
DEAD_LETTER_QUEUE_NAME=mcb-ingest-dlq

# Worker batching: flush after this many readings or this many seconds.
WORKER_BATCH_MAX_READINGS=1000
WORKER_BATCH_MAX_SECONDS=5
WORKER_VISIBILITY_TIMEOUT=30

# Warehouse and pipeline.
DUCKDB_PATH=data/warehouse/mcb.duckdb
DAGSTER_HOME=dagster_home
PIPELINE_MAX_LAG_HOURS=48

# Replay client.
API_URL=http://127.0.0.1:8000
REPLAY_SPEED_FACTOR=60

# Optional LocalStack profile only. Leave empty unless you use that profile.
# The token stays in this local .env or in a GitHub Actions secret, never in git.
LOCALSTACK_AUTH_TOKEN=
